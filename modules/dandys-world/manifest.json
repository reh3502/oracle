  "commands": {
    "namespace": "dw",
    "description": "Dandy's World wiki information",
    "routes": [
      {
        "name": "search",
        "description": "Find wiki entities",
        "operation": "search",
        "input": {
          "kind": "typed",
          "options": [
            {
              "name": "query",
              "description": "Name or search terms",
              "required": true,
              "type": "string",
              "min_length": 1,
              "max_length": 100
            },
            {
              "name": "kind",
              "description": "Entity category",
              "required": false,
              "type": "string",
              "min_length": 1,
              "max_length": 100,
              "choices": [
                "toon",
                "twisted",
                "npc",
                "floor",
                "machine",
                "mechanic",
                "trinket",
                "item",
                "event",
                "topic"
              ]
            },
            {
              "name": "limit",
              "description": "Maximum results",
              "required": false,
              "type": "integer",
              "min_value": 1,
              "max_value": 10
            }
          ]
        },
        "presentation": {
          "kind": "plain_text_v1",
          "pointer": "/reply"
        }
      },
      {
        "name": "lookup",
        "description": "Look up an entity or a specific field",
        "operation": "lookup",
        "input": {
          "kind": "typed",
          "options": [
            {
              "name": "name",
              "description": "Entity name or exact ID",
              "required": true,
              "type": "string",
              "min_length": 1,
              "max_length": 100
            },
            {
              "name": "kind",
              "description": "Entity category",
              "required": false,
              "type": "string",
              "min_length": 1,
              "max_length": 100,
              "choices": [
                "toon",
                "twisted",
                "npc",
                "floor",
                "machine",
                "mechanic",
                "trinket",
                "item",
                "event",
                "topic"
              ]
            },
            {
              "name": "field",
              "description": "Optional field such as health or abilities",
              "required": false,
              "type": "string",
              "min_length": 1,
              "max_length": 100
            },
            {
              "name": "offset",
              "description": "Continue from the offset shown in the previous reply",
              "required": false,
              "type": "integer",
              "min_value": 0,
              "max_value": 100000
            }
          ]
        },
        "presentation": {
          "kind": "plain_text_v1",
          "pointer": "/reply"
        }
      },
      {
        "name": "compare",
