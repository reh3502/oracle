        "operation": "compare",
        "input": {
          "kind": "typed",
          "options": [
            {
              "name": "left",
              "description": "First entity name or exact ID",
              "required": true,
              "type": "string",
              "min_length": 1,
              "max_length": 100
            },
            {
              "name": "right",
              "description": "Second entity name or exact ID",
              "required": true,
              "type": "string",
              "min_length": 1,
              "max_length": 100
            },
            {
              "name": "field",
              "description": "Field to compare",
              "required": false,
              "type": "string",
              "min_length": 1,
              "max_length": 100
            }
          ]
        },
