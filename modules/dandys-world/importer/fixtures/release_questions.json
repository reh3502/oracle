    "page:13376:fact:1": {
      "entity_id": "page:13376",
      "state": "supported",
      "reviewed_support": [
        {
          "quote": "'''Baskets''' are an event [[Currency]] exclusive to the [[Easter Event]]. They are used to buy {{HT|Easter}} [[Skins]], [[Stickers]], and [[Event Toons]] ({{CI|Bassie|name=true}}, {{CI|Cocoa|name=true}}, {{CI|Eggson|name=true}}, and {{CI|Flyte|name=true}}). Any excess Baskets after the event will disappear and will not be transferred over to the next Easter Event.",
          "section": "Overview",
          "source_id": "page:13376",
          "revision_id": 242305,
          "content_sha256": "c9ba1b1a3c4047150321ad98f22f27fee2325136412e2b022f3b65917d3d8787",
          "revision_url": "https://dandys-world-robloxhorror.fandom.com/index.php?oldid=242305"
        },
        {
