{
  "manifest_version": 1,
  "id": "configuration-probe-second",
  "version": "1.0.0",
  "target": "x86_64-unknown-linux-gnu",
  "protocol_major": 1,
  "protocol_minor_min": 0,
  "host_api": "^1.0",
  "data_version": 0,
  "readable_data_versions": [
    0
  ],
  "capabilities": [
    "config.own",
    "events.guild",
    "discord.notify",
    "host.echo"
  ],
  "required_intents": [
    "guilds",
    "guild_members"
  ],
  "operations": [
    {
      "name": "status",
      "description": "Read the test activation epoch",
      "input_schema": {
        "type": "object",
        "additionalProperties": false
      },
      "output_schema": {
        "type": "object"
      },
      "timeout_ms": 1000,
      "capabilities": []
    },
    {
      "name": "ungranted",
      "description": "Must not enter catalog without explicit grant",
      "input_schema": {
        "type": "object"
      },
      "output_schema": {},
      "timeout_ms": 1000,
      "capabilities": [
        "host.echo"
      ]
    }
  ],
  "configuration": {
    "schema_version": 1,
    "schema": {
      "type": "object",
      "required": [
        "destination",
        "level"
      ],
      "additionalProperties": false,
      "properties": {
        "destination": {
          "type": "string",
          "minLength": 1
        },
        "level": {
          "type": "integer",
          "minimum": 0
        },
        "note": {
          "type": "string"
        },
        "reject": {
          "type": "boolean"
        },
        "crash": {
          "type": "boolean"
        },
        "crash_marker": {
          "type": "string"
        },
        "mismatch": {
          "type": "boolean"
        },
        "wait_ms": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10000
        }
      }
    },
    "presets": {
      "moderate/v1": {
        "level": 2
      }
    }
  },
  "subscriptions": [
    "channel_changed",
    "member_joined",
    "maintenance"
  ],
  "commands": {
    "namespace": "configuration-probe",
    "description": "Test module commands",
    "routes": [
      {
        "name": "status",
        "description": "Inspect activation",
        "operation": "status",
        "input_required": false
      },
      {
        "name": "ungranted",
        "description": "Requires a separate grant",
        "operation": "ungranted",
        "input_required": false
      }
    ]
  }
}
