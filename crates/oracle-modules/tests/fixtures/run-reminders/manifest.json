{
  "manifest_version": 3,
  "id": "fixture.run-reminders",
  "version": "1.0.0",
  "target": "x86_64-unknown-linux-gnu",
  "protocol_major": 1,
  "protocol_minor_min": 2,
  "host_api": "^1.6",
  "data_version": 1,
  "readable_data_versions": [
    1
  ],
  "capabilities": [
    "storage.own",
    "shared_cards.publish",
    "config.own",
    "events.guild"
  ],
  "operations": [
    {
      "name": "mutation_probe",
      "description": "Test-only raw callback probe",
      "audience": "member_mutation",
      "input_schema": {
        "type": "object"
      },
      "output_schema": {
        "type": "object"
      },
      "timeout_ms": 5000,
      "capabilities": [
        "storage.own",
        "shared_cards.publish"
      ],
      "callback_methods": [
        "host.document_get",
        "host.document_batch",
        "host.shared_card_status"
      ],
      "callback_collections": [
        "runs",
        "results"
      ]
    },
    {
      "name": "maintenance",
      "description": "Test-only raw callback probe",
      "audience": "operator",
      "input_schema": {
        "type": "object"
      },
      "output_schema": {
        "type": "object"
      },
      "timeout_ms": 5000,
      "capabilities": [
        "storage.own",
        "shared_cards.publish"
      ],
      "callback_methods": [
        "host.document_get",
        "host.document_batch",
        "host.run_reminder"
      ],
      "callback_collections": [
        "runs",
        "results"
      ]
    },
    {
      "name": "member_probe",
      "description": "Test-only raw callback probe",
      "audience": "member_read",
      "input_schema": {
        "type": "object",
        "properties": {
          "method": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "params": {
            "type": "object"
          }
        },
        "required": [
          "method",
          "params"
        ],
        "additionalProperties": false
      },
      "output_schema": {
        "type": "object"
      },
      "timeout_ms": 5000,
      "capabilities": []
    }
  ],
  "collections": [
    {
      "name": "runs",
      "schema": {
        "type": "object",
        "required": [
          "intent",
          "run"
        ],
        "properties": {
          "intent": {
            "type": "object"
          },
          "run": {
            "type": "object"
          }
        },
        "additionalProperties": false
      }
    },
    {
      "name": "results",
      "schema": {
        "type": "object"
      }
    }
  ],
  "commands": {
    "namespace": "callbackprobe",
    "description": "Test-only member callback probe",
    "routes": [
      {
        "name": "probe",
        "description": "Test-only adversarial callback invocation",
        "operation": "member_probe",
        "input": {
          "kind": "json",
          "required": true
        }
      }
    ]
  },
  "member_permissions": [
    "manage_all_runs"
  ],
  "required_intents": [
    "guilds"
  ],
  "subscriptions": [
    "maintenance"
  ],
  "configuration": {
    "schema_version": 1,
    "schema": {
      "type": "object",
      "additionalProperties": false
    },
    "presets": {}
  },
  "shared_cards": {
    "collection": "runs",
    "pointer": "/intent"
  }
}
