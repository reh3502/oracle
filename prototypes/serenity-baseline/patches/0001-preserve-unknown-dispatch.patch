+impl DeserializedEvent {
+    /// Preserve unsupported dispatches instead of discarding information needed by adapters.
+    /// Raw data is untrusted and must be validated before acting on it.
+    pub fn into_event(self) -> Box<Event> {
+        match self {
+            Self::Success(event) => event,
+            Self::Unknown(event) => Box::new(Event::Unknown(event)),
+        }
+    }
+}
